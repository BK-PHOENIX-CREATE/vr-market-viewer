<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VR Market Experience</title>
    <!-- Include A-Frame Library -->
    <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
</head>
<body>
    <a-scene background="color: #ECECEC">
        <!-- Asset Management -->
        <a-assets>
            <!-- Replace 'market-model.glb' with your actual file name -->
            <a-asset-item id="market" src="./models/market-model.glb"></a-asset-item>
        </a-assets>

        <!-- 3D Market Model -->
        <!-- Adjust position, rotation, and scale as needed for your model -->
        <a-entity gltf-model="#market" position="0 0 -5" scale="1 1 1" rotation="0 45 0"></a-entity>

        <!-- Environment / Lighting -->
        <a-light type="ambient" color="#fff" intensity="0.8"></a-light>
        <a-light type="directional" color="#fff" intensity="0.5" position="-1 2 1"></a-light>

        <!-- VR Camera Rig with movement/teleport controls -->
        <a-entity id="rig" position="0 0 2">
            <a-camera camera look-controls wasd-controls></a-camera>
            <!-- VR Controllers support -->
            <a-entity laser-controls="hand: right"></a-entity>
            <a-entity laser-controls="hand: left"></a-entity>
        </a-entity>
    </a-scene>
</body>
</html>
